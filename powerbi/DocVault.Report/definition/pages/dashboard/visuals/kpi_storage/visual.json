{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "kpi_storage",
  "position": { "x": 460, "y": 20, "z": 0, "width": 200, "height": 110, "tabOrder": 300 },
  "visual": {
    "visualType": "card",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "queryRef": "Sum(Documents.file_size_bytes)",
              "field": {
                "Aggregation": {
                  "Expression": { "Column": { "Expression": { "SourceRef": { "Source": "Documents" } }, "Property": "file_size_bytes" } },
                  "Function": 0
                }
              },
              "format": "#,0 \" KB\""
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": { "expr": { "Literal": "\"Total Storage Used\"" } },
            "fontColor": { "solid": { "color": "#1F4E79" } },
            "fontSize": 11,
            "bold": true
          }
        }
      ]
    }
  }
}
