{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "chart_confidence_hist",
  "position": { "x": 460, "y": 150, "z": 0, "width": 400, "height": 280, "tabOrder": 500 },
  "visual": {
    "visualType": "columnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "queryRef": "Documents.ml_confidence",
              "field": { "Column": { "Expression": { "SourceRef": { "Source": "Documents" } }, "Property": "ml_confidence" } }
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "queryRef": "Count(Documents.name)",
              "field": {
                "Aggregation": {
                  "Expression": { "Column": { "Expression": { "SourceRef": { "Source": "Documents" } }, "Property": "name" } },
                  "Function": 2
                }
              }
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": true,
            "text": { "expr": { "Literal": "\"Model Confidence Distribution\"" } },
            "fontColor": { "solid": { "color": "#1F4E79" } },
            "fontSize": 12,
            "bold": true
          }
        }
      ]
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fillColor": { "solid": { "color": "#10B981" } }
          }
        }
      ],
      "labels": [
        {
          "properties": {
            "show": true
          }
        }
      ]
    }
  }
}
